# ScrapeCreators — https://scrapecreators.com (free, no card, 100 starter credits)
SCRAPECREATORS_API_KEY=

# Resend — https://resend.com (free tier)
RESEND_API_KEY=
# onboarding@resend.dev works out of the box with no domain verification needed
RESEND_FROM_EMAIL=onboarding@resend.dev
REPORT_TO_EMAIL=

# Slack app (Bot Token) — api.slack.com/apps -> OAuth & Permissions -> add the
# chat:write and channels:manage Bot Token Scopes -> Install to Workspace.
# Each brand's channel is named in data/accounts.json and created automatically.
SLACK_BOT_TOKEN=
# Comma-separated Slack member IDs to auto-add to each new brand channel.
# Find yours: avatar -> Profile -> More (...) -> Copy member ID
SLACK_INVITE_USER_IDS=
